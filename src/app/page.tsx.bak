                </svg>
              </div>

              {/* Route Line */}
              <svg className="absolute inset-0 w-full h-full" viewBox="0 0 400 400">
                <path
                  d="M 100 300 Q 150 200 200 250 Q 250 300 300 150"
                  fill="none"
                  stroke="currentColor"
                  strokeWidth="4"
                  strokeDasharray="8 4"
