              </h1>
              <p className="text-lg text-muted-foreground max-w-lg">
                Request a ride, hop in, and go. Access ride options for every budget and schedule.
              </p>
            </div>

            <div className="flex flex-col sm:flex-row gap-4">
              <Button size="lg" className="text-lg px-8" onClick={handleBookRide}>
                Book a Ride
                <ArrowRight className="w-5 h-5 ml-2" />
              </Button>
              <Button size="lg" variant="outline" className="text-lg px-8">
                Drive with Us
              </Button>
            </div>

            <div className="grid grid-cols-3 gap-8 pt-4">
              <div>
                <div className="text-3xl font-bold">10M+</div>
                <div className="text-sm text-muted-foreground">Active Riders</div>
              </div>
              <div>
                <div className="text-3xl font-bold">500K+</div>
                <div className="text-sm text-muted-foreground">Drivers</div>
