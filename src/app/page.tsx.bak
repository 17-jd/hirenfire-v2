                />
                {/* Pickup Point */}
                <circle cx="100" cy="300" r="12" className="fill-green-500" />
                <circle cx="100" cy="300" r="20" className="fill-green-500/20" />
                {/* Dropoff Point */}
                <circle cx="300" cy="150" r="12" className="fill-red-500" />
                <circle cx="300" cy="150" r="20" className="fill-red-500/20" />
              </svg>

              {/* Car Icon */}
              <div
                className="absolute w-12 h-12 bg-black rounded-full flex items-center justify-center shadow-lg"
                style={{ top: '55%', left: '45%' }}
              >
                <Car className="w-6 h-6 text-white" />
              </div>

              {/* Location Cards */}
              <Card className="absolute top-8 left-8 w-48 shadow-lg">
                <CardContent className="p-3">
                  <div className="flex items-center gap-2">
                    <div className="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                      <MapPin className="w-4 h-4 text-green-600" />
                    </div>
                    <div>
                      <div className="text-xs text-muted-foreground">Pickup</div>
                      <div className="text-sm font-medium">Downtown</div>
                    </div>
                  </div>
                </CardContent>
              </Card>

              <Card className="absolute bottom-8 right-8 w-48 shadow-lg">
                <CardContent className="p-3">
                  <div className="flex items-center gap-2">
                    <div className="w-8 h-8 bg-red-100 rounded-full flex items-center justify-center">
                      <Navigation className="w-4 h-4 text-red-600" />
