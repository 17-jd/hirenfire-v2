                  {type.features.map((feature, i) => (
                    <li key={i} className="flex items-center gap-2 text-sm">
                      <CheckCircle className="w-4 h-4 text-green-500" />
                      {feature}
                    </li>
                  ))}
                </ul>
              </CardContent>
            </Card>
          ))}
        </div>
      </div>
    </section>
  )
}

// ============ BOOKING VIEW ============
function BookingView() {
  const { user, setCurrentView, currentRide, setCurrentRide, setCurrentView: setView } = useAppStore()
  const [step, setStep] = useState(1)
  const [isLoading, setIsLoading] = useState(false)
  const [formData, setFormData] = useState({
    pickupAddress: '',
    dropoffAddress: '',
    rideType: 'standard',
  })

  const estimatedFares = {
    standard: 8 + Math.random() * 10,
    premium: 15 + Math.random() * 15,
    pool: 5 + Math.random() * 5,
  }

  const handleBookRide = async () => {
    setIsLoading(true)
    try {
      const { ride } = await ridesAPI.create({
        pickupAddress: formData.pickupAddress,
        dropoffAddress: formData.dropoffAddress,
        rideType: formData.rideType,
      })
      setCurrentRide(ride)
      setStep(3)
      toast({ title: 'Ride requested!', description: 'Looking for nearby drivers...' })
    } catch (error) {
      toast({
        title: 'Booking failed',
        description: error instanceof Error ? error.message : 'Please try again',
        variant: 'destructive',
      })
    } finally {
      setIsLoading(false)
    }
  }

  return (
    <section className="pt-24 pb-16 px-4">
      <div className="max-w-4xl mx-auto">
        <Button variant="ghost" onClick={() => setCurrentView('landing')} className="mb-6">
          <ArrowRight className="w-4 h-4 mr-2 rotate-180" />
          Back to Home
        </Button>

        <div className="grid lg:grid-cols-5 gap-8">
          {/* Booking Form */}
          <div className="lg:col-span-2 space-y-6">
            <div>
              <h1 className="text-2xl font-bold mb-2">Book Your Ride</h1>
              <p className="text-muted-foreground">Enter your pickup and drop-off locations</p>
            </div>

            {/* Progress */}
            <div className="flex items-center gap-2">
              {[1, 2, 3].map((s) => (
                <div
                  key={s}
                  className={`h-2 flex-1 rounded-full ${
                    s <= step ? 'bg-primary' : 'bg-muted'
                  }`}
                />
              ))}
            </div>

            {step === 1 && (
              <Card>
                <CardHeader>
                  <CardTitle className="text-lg">Locations</CardTitle>
                </CardHeader>
                <CardContent className="space-y-4">
                  <div className="space-y-2">
                    <Label htmlFor="pickup">Pickup Location</Label>
                    <div className="relative">
                      <MapPin className="absolute left-3 top-3 w-4 h-4 text-green-500" />
                      <Input
                        id="pickup"
                        placeholder="Enter pickup address"
                        className="pl-10"
                        value={formData.pickupAddress}
                        onChange={(e) => setFormData({ ...formData, pickupAddress: e.target.value })}
                      />
                    </div>
                  </div>
                  <div className="space-y-2">
                    <Label htmlFor="dropoff">Drop-off Location</Label>
                    <div className="relative">
                      <Navigation className="absolute left-3 top-3 w-4 h-4 text-red-500" />
                      <Input
                        id="dropoff"
                        placeholder="Enter destination"
                        className="pl-10"
                        value={formData.dropoffAddress}
                        onChange={(e) => setFormData({ ...formData, dropoffAddress: e.target.value })}
                      />
                    </div>
                  </div>
                  <Button
                    className="w-full"
                    disabled={!formData.pickupAddress || !formData.dropoffAddress}
                    onClick={() => setStep(2)}
                  >
                    Continue
                  </Button>
                </CardContent>
              </Card>
            )}

            {step === 2 && (
              <Card>
                <CardHeader>
                  <CardTitle className="text-lg">Choose Ride Type</CardTitle>
                </CardHeader>
                <CardContent className="space-y-4">
                  {(['standard', 'premium', 'pool'] as const).map((type) => (
                    <div
                      key={type}
                      className={`p-4 border rounded-lg cursor-pointer transition-all ${
                        formData.rideType === type
                          ? 'border-primary bg-primary/5'
                          : 'hover:border-muted-foreground/50'
                      }`}
                      onClick={() => setFormData({ ...formData, rideType: type })}
                    >
                      <div className="flex items-center justify-between">
                        <div className="flex items-center gap-3">
                          <div className="w-10 h-10 bg-muted rounded-lg flex items-center justify-center">
                            <Car className="w-5 h-5" />
                          </div>
                          <div>
                            <div className="font-medium capitalize">{type}</div>
                            <div className="text-sm text-muted-foreground">
                              {type === 'standard' && '4 seats • 5 min away'}
                              {type === 'premium' && '4 seats • 8 min away'}
                              {type === 'pool' && '2 seats • 10 min away'}
                            </div>
                          </div>
                        </div>
                        <div className="text-right">
                          <div className="font-bold">${estimatedFares[type].toFixed(2)}</div>
                        </div>
                      </div>
                    </div>
                  ))}
                  <div className="flex gap-2 pt-2">
                    <Button variant="outline" onClick={() => setStep(1)}>
                      Back
                    </Button>
                    <Button
                      className="flex-1"
                      onClick={handleBookRide}
                      disabled={isLoading}
                    >
                      {isLoading ? 'Requesting...' : `Request ${formData.rideType}`}
                    </Button>
                  </div>
                </CardContent>
              </Card>
            )}

            {step === 3 && currentRide && (
              <Card>
                <CardHeader>
                  <CardTitle className="text-lg">
                    {currentRide.status === 'pending' && 'Finding Driver...'}
                    {currentRide.status === 'accepted' && 'Driver on the way!'}
                    {currentRide.status === 'in_progress' && 'Ride in progress'}
                  </CardTitle>
                </CardHeader>
                <CardContent className="space-y-4">
                  {currentRide.status === 'pending' && (
                    <div className="text-center py-8">
                      <div className="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4 animate-pulse">
                        <Car className="w-8 h-8" />
                      </div>
                      <p className="text-muted-foreground">Looking for nearby drivers...</p>
                    </div>
                  )}

                  {(currentRide.status === 'accepted' || currentRide.status === 'in_progress') && currentRide.driver && (
                    <>
                      <div className="flex items-center gap-4 p-4 bg-muted rounded-lg">
                        <Avatar className="w-12 h-12">
                          <AvatarFallback>{currentRide.driver.name.charAt(0)}</AvatarFallback>
                        </Avatar>
                        <div className="flex-1">
                          <div className="font-medium">{currentRide.driver.name}</div>
                          <div className="flex items-center gap-1 text-sm text-muted-foreground">
                            <Star className="w-3 h-3 fill-yellow-400 text-yellow-400" />
                            {currentRide.driver.rating.toFixed(1)}
                          </div>
                        </div>
                        <div className="flex gap-2">
                          <Button size="icon" variant="outline">
                            <Phone className="w-4 h-4" />
                          </Button>
                          <Button size="icon" variant="outline">
                            <Mail className="w-4 h-4" />
                          </Button>
                        </div>
                      </div>

                      <div className="space-y-2">
                        <div className="flex items-center gap-2 text-sm">
                          <MapPin className="w-4 h-4 text-green-500" />
                          {formData.pickupAddress}
                        </div>
                        <div className="flex items-center gap-2 text-sm">
                          <Navigation className="w-4 h-4 text-red-500" />
                          {formData.dropoffAddress}
                        </div>
                      </div>
                    </>
                  )}

                  <div className="flex justify-between text-sm">
                    <span className="text-muted-foreground">Estimated fare</span>
                    <span className="font-bold">${estimatedFares[formData.rideType as keyof typeof estimatedFares].toFixed(2)}</span>
                  </div>

                  {currentRide.status === 'pending' && (
                    <Button
                      variant="destructive"
                      className="w-full"
                      onClick={async () => {
                        try {
                          await ridesAPI.cancel(currentRide.id, 'Changed mind')
                          setCurrentRide(null)
                          setStep(1)
                          toast({ title: 'Ride cancelled' })
                        } catch (error) {
                          toast({ title: 'Failed to cancel', variant: 'destructive' })
                        }
                      }}
                    >
                      Cancel Request
                    </Button>
                  )}
                </CardContent>
              </Card>
            )}
          </div>

          {/* Map Placeholder */}
          <div className="lg:col-span-3">
            <div className="aspect-square lg:aspect-auto lg:h-full bg-gradient-to-br from-muted to-muted/50 rounded-2xl overflow-hidden relative">
              {/* Map Background */}
              <div className="absolute inset-0 opacity-30">
                <svg className="w-full h-full" viewBox="0 0 400 400">
                  <defs>
                    <pattern id="grid2" width="20" height="20" patternUnits="userSpaceOnUse">
                      <path d="M 20 0 L 0 0 0 20" fill="none" stroke="currentColor" strokeWidth="0.5" />
                    </pattern>
                  </defs>
                  <rect width="100%" height="100%" fill="url(#grid2)" />
                </svg>
              </div>

              {/* Route */}
              {formData.pickupAddress && formData.dropoffAddress && (
                <svg className="absolute inset-0 w-full h-full" viewBox="0 0 400 400">
                  <path
                    d="M 80 320 Q 200 200 320 80"
                    fill="none"
                    stroke="currentColor"
                    strokeWidth="3"
                    className="text-primary"
                  />
                  <circle cx="80" cy="320" r="10" className="fill-green-500" />
                  <circle cx="320" cy="80" r="10" className="fill-red-500" />
                </svg>
              )}

              {/* Center Text */}
              {!formData.pickupAddress && (
                <div className="absolute inset-0 flex items-center justify-center">
                  <div className="text-center text-muted-foreground">
                    <MapPin className="w-12 h-12 mx-auto mb-2 opacity-50" />
                    <p>Enter locations to see route</p>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

// ============ DRIVER DASHBOARD ============
function DriverDashboard() {
  const { user, isOnline, setIsOnline, pendingRides, setPendingRides, currentRide, setCurrentRide } = useAppStore()
  const [isLoading, setIsLoading] = useState(false)

  useEffect(() => {
    if (isOnline) {
      const fetchPendingRides = async () => {
        try {
          const { rides } = await ridesAPI.getPending()
          setPendingRides(rides)
        } catch (error) {
          console.error('Failed to fetch pending rides:', error)
        }
      }
      fetchPendingRides()
      const interval = setInterval(fetchPendingRides, 5000)
      return () => clearInterval(interval)
    }
  }, [isOnline, setPendingRides])

  const handleAcceptRide = async (rideId: string) => {
    setIsLoading(true)
    try {
      const { ride } = await ridesAPI.accept(rideId)
      setCurrentRide(ride)
      setPendingRides(pendingRides.filter(r => r.id !== rideId))
      toast({ title: 'Ride accepted!', description: 'Navigate to pickup location' })
    } catch (error) {
      toast({ title: 'Failed to accept ride', variant: 'destructive' })
    } finally {
      setIsLoading(false)
    }
  }

  const handleStartRide = async () => {
    if (!currentRide) return
    try {
      const { ride } = await ridesAPI.start(currentRide.id)
      setCurrentRide(ride)
      toast({ title: 'Ride started!' })
    } catch (error) {
      toast({ title: 'Failed to start ride', variant: 'destructive' })
    }
  }

  const handleCompleteRide = async () => {
    if (!currentRide) return
    try {
      const { ride } = await ridesAPI.complete(currentRide.id)
      setCurrentRide(null)
      toast({ title: 'Ride completed!', description: `Earned $${ride.fare.toFixed(2)}` })
    } catch (error) {
      toast({ title: 'Failed to complete ride', variant: 'destructive' })
    }
  }

  return (
    <section className="pt-24 pb-16 px-4">
      <div className="max-w-6xl mx-auto">
        <div className="grid lg:grid-cols-3 gap-6">
          {/* Left Panel - Status */}
          <div className="lg:col-span-1 space-y-6">
            <Card>
              <CardHeader>
                <div className="flex items-center justify-between">
                  <CardTitle>Driver Status</CardTitle>
                  <Badge variant={isOnline ? 'default' : 'secondary'}>
                    {isOnline ? 'Online' : 'Offline'}
                  </Badge>
                </div>
              </CardHeader>
              <CardContent className="space-y-4">
                <div className="flex items-center justify-between">
                  <span className="text-sm">Go Online</span>
                  <Switch
                    checked={isOnline}
                    onCheckedChange={setIsOnline}
                  />
                </div>

                <div className="grid grid-cols-2 gap-4 pt-4">
                  <div className="text-center p-4 bg-muted rounded-lg">
                    <div className="text-2xl font-bold">${(user?.totalRides || 0) * 15}</div>
                    <div className="text-xs text-muted-foreground">Today's Earnings</div>
                  </div>
                  <div className="text-center p-4 bg-muted rounded-lg">
                    <div className="text-2xl font-bold">{user?.totalRides || 0}</div>
                    <div className="text-xs text-muted-foreground">Rides Today</div>
                  </div>
                </div>
              </CardContent>
            </Card>

            <Card>
              <CardHeader>
                <CardTitle className="text-lg">Your Rating</CardTitle>
              </CardHeader>
              <CardContent>
                <div className="flex items-center gap-2">
                  <Star className="w-8 h-8 fill-yellow-400 text-yellow-400" />
                  <span className="text-3xl font-bold">{user?.rating.toFixed(1)}</span>
                  <span className="text-muted-foreground">/ 5.0</span>
                </div>
              </CardContent>
            </Card>
          </div>

          {/* Right Panel - Rides */}
          <div className="lg:col-span-2 space-y-6">
            {/* Current Ride */}
            {currentRide && (
              <Card className="border-primary">
                <CardHeader>
                  <div className="flex items-center justify-between">
                    <CardTitle>Current Ride</CardTitle>
                    <Badge>
                      {currentRide.status === 'accepted' && 'Accepted'}
                      {currentRide.status === 'in_progress' && 'In Progress'}
                    </Badge>
                  </div>
                </CardHeader>
                <CardContent className="space-y-4">
                  <div className="space-y-3">
                    <div className="flex items-start gap-3">
                      <div className="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0">
                        <MapPin className="w-4 h-4 text-green-600" />
                      </div>
                      <div>
                        <div className="text-xs text-muted-foreground">Pickup</div>
                        <div className="font-medium">{currentRide.pickupAddress}</div>
                      </div>
                    </div>
                    <div className="flex items-start gap-3">
                      <div className="w-8 h-8 bg-red-100 rounded-full flex items-center justify-center flex-shrink-0">
                        <Navigation className="w-4 h-4 text-red-600" />
                      </div>
                      <div>
                        <div className="text-xs text-muted-foreground">Dropoff</div>
                        <div className="font-medium">{currentRide.dropoffAddress}</div>
                      </div>
                    </div>
                  </div>

                  <div className="flex items-center justify-between p-3 bg-muted rounded-lg">
                    <div className="flex items-center gap-2">
                      <span className="text-muted-foreground">Fare:</span>
                      <span className="text-xl font-bold">${currentRide.fare.toFixed(2)}</span>
                    </div>
                    <Badge variant="outline">{currentRide.rideType}</Badge>
                  </div>

                  <div className="flex gap-2">
                    {currentRide.status === 'accepted' && (
                      <Button className="flex-1" onClick={handleStartRide}>
                        <Play className="w-4 h-4 mr-2" />
                        Start Ride
                      </Button>
                    )}
                    {currentRide.status === 'in_progress' && (
                      <Button className="flex-1" onClick={handleCompleteRide}>
                        <Square className="w-4 h-4 mr-2" />
                        Complete Ride
                      </Button>
                    )}
                  </div>
                </CardContent>
              </Card>
            )}

            {/* Pending Rides */}
            {!currentRide && (
              <Card>
                <CardHeader>
                  <CardTitle>Ride Requests</CardTitle>
                  <CardDescription>
                    {isOnline ? 'New ride requests will appear here' : 'Go online to receive ride requests'}
                  </CardDescription>
                </CardHeader>
                <CardContent>
                  {!isOnline ? (
                    <div className="text-center py-8 text-muted-foreground">
                      <Car className="w-12 h-12 mx-auto mb-2 opacity-50" />
                      <p>Go online to start receiving rides</p>
                    </div>
                  ) : pendingRides.length === 0 ? (
                    <div className="text-center py-8 text-muted-foreground">
                      <Clock className="w-12 h-12 mx-auto mb-2 opacity-50" />
                      <p>Waiting for ride requests...</p>
                    </div>
                  ) : (
                    <ScrollArea className="max-h-96">
                      <div className="space-y-4">
                        {pendingRides.map((ride) => (
                          <div
                            key={ride.id}
                            className="p-4 border rounded-lg space-y-3"
                          >
                            <div className="flex items-center justify-between">
                              <Badge>{ride.rideType}</Badge>
                              <span className="font-bold text-lg">${ride.fare.toFixed(2)}</span>
                            </div>
                            <div className="space-y-2 text-sm">
                              <div className="flex items-center gap-2">
                                <MapPin className="w-4 h-4 text-green-500" />
                                {ride.pickupAddress}
                              </div>
                              <div className="flex items-center gap-2">
                                <Navigation className="w-4 h-4 text-red-500" />
                                {ride.dropoffAddress}
                              </div>
                            </div>
                            <div className="flex gap-2">
                              <Button
                                className="flex-1"
                                onClick={() => handleAcceptRide(ride.id)}
                                disabled={isLoading}
                              >
                                Accept
                              </Button>
                              <Button variant="outline">Decline</Button>
                            </div>
                          </div>
                        ))}
                      </div>
                    </ScrollArea>
                  )}
                </CardContent>
              </Card>
            )}
          </div>
        </div>
      </div>
    </section>
  )
}

// ============ RIDE HISTORY ============
function RideHistory() {
  const { user, rides, setRides, setCurrentView } = useAppStore()
  const [isLoading, setIsLoading] = useState(true)

  useEffect(() => {
    const fetchRides = async () => {
      try {
        const { rides: fetchedRides } = await ridesAPI.getAll()
        setRides(fetchedRides)
      } catch (error) {
        console.error('Failed to fetch rides:', error)
      } finally {
        setIsLoading(false)
      }
    }
    fetchRides()
  }, [setRides])

  return (
    <section className="pt-24 pb-16 px-4">
      <div className="max-w-4xl mx-auto">
        <Button variant="ghost" onClick={() => setCurrentView('landing')} className="mb-6">
          <ArrowRight className="w-4 h-4 mr-2 rotate-180" />
          Back
        </Button>

        <h1 className="text-2xl font-bold mb-6">Ride History</h1>

        {isLoading ? (
          <div className="space-y-4">
            {[1, 2, 3].map((i) => (
              <Card key={i}>
                <CardContent className="p-6">
                  <div className="animate-pulse flex items-center gap-4">
                    <div className="w-12 h-12 bg-muted rounded-full" />
                    <div className="flex-1 space-y-2">
                      <div className="h-4 bg-muted rounded w-1/3" />
                      <div className="h-3 bg-muted rounded w-1/2" />
                    </div>
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
        ) : rides.length === 0 ? (
          <Card>
            <CardContent className="py-12 text-center">
              <Car className="w-12 h-12 mx-auto mb-4 text-muted-foreground opacity-50" />
              <h3 className="font-medium mb-2">No rides yet</h3>
              <p className="text-sm text-muted-foreground mb-4">
                Book your first ride to get started
              </p>
              <Button onClick={() => setCurrentView('booking')}>Book a Ride</Button>
            </CardContent>
          </Card>
        ) : (
          <ScrollArea className="max-h-[600px]">
            <div className="space-y-4">
              {rides.map((ride) => (
                <Card key={ride.id}>
                  <CardContent className="p-6">
                    <div className="flex items-start justify-between mb-4">
                      <div className="flex items-center gap-3">
                        <div className="w-12 h-12 bg-muted rounded-full flex items-center justify-center">
                          <Car className="w-6 h-6" />
                        </div>
                        <div>
                          <div className="font-medium capitalize">{ride.rideType} Ride</div>
                          <div className="text-sm text-muted-foreground">
                            {new Date(ride.requestedAt).toLocaleDateString()}
                          </div>
                        </div>
                      </div>
                      <Badge
                        variant={
                          ride.status === 'completed' ? 'default' :
                          ride.status === 'cancelled' ? 'destructive' :
                          'secondary'
                        }
                      >
                        {ride.status}
                      </Badge>
                    </div>

                    <div className="space-y-2 mb-4">
                      <div className="flex items-center gap-2 text-sm">
                        <MapPin className="w-4 h-4 text-green-500" />
                        {ride.pickupAddress}
                      </div>
                      <div className="flex items-center gap-2 text-sm">
                        <Navigation className="w-4 h-4 text-red-500" />
                        {ride.dropoffAddress}
                      </div>
                    </div>

                    <div className="flex items-center justify-between pt-4 border-t">
                      <div className="flex items-center gap-4 text-sm text-muted-foreground">
                        {ride.distance && <span>{ride.distance.toFixed(1)} km</span>}
                        {ride.duration && <span>{ride.duration} min</span>}
                      </div>
                      <div className="text-lg font-bold">${ride.fare.toFixed(2)}</div>
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </ScrollArea>
        )}
      </div>
    </section>
  )
}

// ============ FOOTER ============
function Footer() {
  return (
    <footer className="bg-muted/50 border-t mt-auto">
      <div className="max-w-7xl mx-auto px-4 py-8">
        <div className="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8">
          <div>
            <div className="flex items-center gap-2 mb-4">
              <div className="w-8 h-8 bg-black rounded-lg flex items-center justify-center">
                <Car className="w-4 h-4 text-white" />
              </div>
              <span className="font-bold">RideGo</span>
            </div>
            <p className="text-sm text-muted-foreground">
              The smart way to get around.
            </p>
          </div>

          <div>
            <h4 className="font-medium mb-3">Company</h4>
            <ul className="space-y-2 text-sm text-muted-foreground">
              <li><a href="#" className="hover:text-foreground">About</a></li>
              <li><a href="#" className="hover:text-foreground">Careers</a></li>
              <li><a href="#" className="hover:text-foreground">Blog</a></li>
            </ul>
          </div>

          <div>
            <h4 className="font-medium mb-3">Products</h4>
            <ul className="space-y-2 text-sm text-muted-foreground">
              <li><a href="#" className="hover:text-foreground">Ride</a></li>
              <li><a href="#" className="hover:text-foreground">Drive</a></li>
              <li><a href="#" className="hover:text-foreground">Business</a></li>
            </ul>
          </div>

          <div>
            <h4 className="font-medium mb-3">Support</h4>
            <ul className="space-y-2 text-sm text-muted-foreground">
              <li><a href="#" className="hover:text-foreground">Help Center</a></li>
              <li><a href="#" className="hover:text-foreground">Safety</a></li>
              <li><a href="#" className="hover:text-foreground">Terms</a></li>
            </ul>
          </div>
        </div>

        <div className="pt-8 border-t text-center text-sm text-muted-foreground">
          © 2024 RideGo. All rights reserved.
        </div>
      </div>
    </footer>
  )
}

// ============ MAIN APP ============
export default function Home() {
  const { currentView, isAuthenticated, user, setUser, setLoading } = useAppStore()

  // Check for existing session on mount
  useEffect(() => {
    const checkAuth = async () => {
      try {
        const { user } = await authAPI.me()
        setUser(user)
      } catch {
        // Not logged in
      }
    }
    checkAuth()
  }, [setUser])

  return (
    <div className="min-h-screen flex flex-col">
      <Navigation />
      <AuthModal />

      <main className="flex-1">
        {currentView === 'landing' && (
          <>
            <HeroSection />
            <FeaturesSection />
            <RideTypesSection />
          </>
        )}

        {currentView === 'booking' && <BookingView />}

        {currentView === 'driver' && <DriverDashboard />}

        {currentView === 'history' && <RideHistory />}
      </main>

      <Footer />
    </div>
  )
}
